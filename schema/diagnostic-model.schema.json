{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowPilot diagnostic model, conservative rectangle profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "source", "geometry", "material", "boundaries"],
  "properties": {
    "schema_version": {"const": "diagnostic-0.1"},
    "profile": {"const": "rectangular-channel-v1"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["comsol_version", "component_tag", "physics_tag", "study_tag"],
      "properties": {
        "comsol_version": {"type": "string"}, "component_tag": {"type": "string", "minLength": 1},
        "physics_tag": {"type": "string", "minLength": 1}, "study_tag": {"type": "string", "minLength": 1}
      }
    },
    "geometry": {
      "type": "object", "additionalProperties": false, "required": ["length_m", "height_m"],
      "properties": {"length_m": {"type": "number", "exclusiveMinimum": 0}, "height_m": {"type": "number", "exclusiveMinimum": 0}}
    },
    "material": {
      "type": "object", "additionalProperties": false, "required": ["density", "dynamic_viscosity"],
      "properties": {
        "density": {"allOf": [{"$ref": "#/$defs/evaluated"}, {"properties": {"unit": {"const": "kg/m^3"}}}]},
        "dynamic_viscosity": {"allOf": [{"$ref": "#/$defs/evaluated"}, {"properties": {"unit": {"const": "Pa*s"}}}]}
      }
    },
    "boundaries": {"type": "array", "items": {"$ref": "#/$defs/boundary"}}
  },
  "$defs": {
    "ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4}},
    "evaluated": {
      "type": "object", "additionalProperties": false, "required": ["expression", "unit", "status", "value"],
      "properties": {
        "expression": {"type": "string"}, "unit": {"type": "string"},
        "status": {"enum": ["resolved", "unresolved"]}, "value": {"type": ["number", "null"]}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "resolved"}}},
                 "then": {"properties": {"value": {"type": "number"}}},
                 "else": {"properties": {"value": {"type": "null"}}}}]
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["feature_tag", "label", "type", "boundary_ids", "declared_boundary_ids", "selection_scope", "mode", "parameters"],
      "properties": {
        "feature_tag": {"type": "string", "minLength": 1}, "label": {"type": "string"},
        "type": {"enum": ["inlet", "outlet", "wall"]}, "boundary_ids": {"$ref": "#/$defs/ids"},
        "declared_boundary_ids": {"anyOf": [{"$ref": "#/$defs/ids"}, {"type": "null"}]},
        "selection_scope": {"enum": ["explicit", "fallback"]},
        "mode": {"type": "string"}, "parameters": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "inlet"}}}, "then": {"properties": {
          "mode": {"const": "Velocity"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["normal_velocity"],
            "properties": {"normal_velocity": {"allOf": [{"$ref": "#/$defs/evaluated"}, {"properties": {"unit": {"const": "m/s"}}}]}}}
        }}},
        {"if": {"properties": {"type": {"const": "outlet"}}}, "then": {"properties": {
          "mode": {"const": "PressureNoViscousStress"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["pressure"],
            "properties": {"pressure": {"allOf": [{"$ref": "#/$defs/evaluated"}, {"properties": {"unit": {"const": "Pa"}}}]}}}
        }}},
        {"if": {"properties": {"type": {"const": "wall"}}}, "then": {"properties": {
          "mode": {"const": "NoSlip"}, "parameters": {"type": "object", "maxProperties": 0}
        }}}
      ]
    }
  }
}
