{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowPlot M0 modular diagnosis envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_status",
    "status",
    "findings",
    "coverage",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": "diagnosis-0.2"
    },
    "run_status": {
      "const": "completed"
    },
    "status": {
      "enum": [
        "checked",
        "partial",
        "unsupported"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "explanation",
          "feature_tags",
          "boundary_ids",
          "evidence",
          "module",
          "source"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "Critical",
              "Warning",
              "Suggestion"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "feature_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "boundary_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "evidence": {
            "type": "object"
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/physicsSource"
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "module",
          "source",
          "status",
          "applicable",
          "reason",
          "evidence_refs",
          "rules"
        ],
        "properties": {
          "kind": {
            "enum": [
              "physics",
              "coupling"
            ]
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object"
          },
          "status": {
            "enum": [
              "checked",
              "skipped",
              "unknown"
            ]
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rule_id",
                "status",
                "reason",
                "dependencies",
                "evidence_refs"
              ],
              "properties": {
                "rule_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "checked",
                    "skipped",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "dependencies": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^/"
                  }
                },
                "cases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "feature_tag",
                      "status",
                      "reason",
                      "evidence_refs"
                    ],
                    "properties": {
                      "feature_tag": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "checked",
                          "skipped"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_refs": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^/"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "physics"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "$ref": "#/$defs/physicsSource"
                }
              }
            },
            "else": {
              "properties": {
                "source": {
                  "$ref": "#/$defs/couplingSource"
                }
              }
            }
          }
        ]
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "source",
          "status"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/physicsSource"
          },
          "status": {
            "enum": [
              "checked",
              "partial",
              "unsupported"
            ]
          },
          "model": {
            "type": "object"
          }
        }
      }
    },
    "model": {
      "type": "object"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "numeric_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reynolds_threshold_guard_ulps"
      ],
      "properties": {
        "reynolds_threshold_guard_ulps": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "unsupported"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "physicsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_tag",
        "physics_tag"
      ],
      "properties": {
        "component_tag": {
          "type": "string"
        },
        "physics_tag": {
          "type": "string",
          "minLength": 1
        },
        "geometry_tag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "couplingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_tag",
        "coupling_tag"
      ],
      "properties": {
        "component_tag": {
          "type": "string"
        },
        "coupling_tag": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
