import com.comsol.model.Model;
import com.comsol.model.util.ModelUtil;
import java.util.Arrays;
/** Controlled unsolved heating and conjugate pipe models; no source model is modified. */
public class M3ApiProbe {
  private static final String OUTPUT="@OUTPUT@", BASE="@BASE@";
  private static final String[] NAMES={"normal","missing_inlet","missing_outlet","selection_overlap","empty_inlet","reversed_inlet","high_reynolds","wall_on_inlet","slip_wall","invalid_viscosity","invalid_k","empty_heat_flux","thermal_overlap","disabled_coupling","conjugate_normal","conjugate_missing_wall_k"};
  public static void main(String[] args) throws Exception {
    System.out.println("M3_LICENSE_BASELINE "+ModelUtil.hasProductForFile(BASE));
    Model m; try {m=build(false);} catch(Exception e){e.printStackTrace();throw e;}m.save(OUTPUT+"/normal.mph");ModelUtil.remove("Build");
    m=build(true);m.save(OUTPUT+"/conjugate_normal.mph");ModelUtil.remove("Build");
    for(String name:NAMES) {
      if(name.equals("normal")||name.equals("conjugate_normal"))continue;
      m=ModelUtil.load("Variant",OUTPUT+"/"+(name.startsWith("conjugate_")?"conjugate_normal":"normal")+".mph");
      try {
        if(name.equals("missing_inlet"))m.component("comp1").physics("spf").feature().remove("inl1");
        if(name.equals("missing_outlet"))m.component("comp1").physics("spf").feature().remove("out1");
        if(name.equals("empty_inlet"))m.component("comp1").physics("spf").feature("inl1").selection().clear();
        if(name.equals("selection_overlap"))m.component("comp1").physics("spf").feature("out1").selection().named("inlet");
        if(name.equals("wall_on_inlet")) {
          m.component("comp1").physics("spf").create("wall_bad","WallBC",2);
          m.component("comp1").physics("spf").feature("wall_bad").selection().named("inlet");
        }
        if(name.equals("slip_wall"))m.component("comp1").physics("spf").feature("wallbc1").set("BoundaryCondition","Slip");
        if(name.equals("invalid_viscosity"))m.component("comp1").material("mat1").propertyGroup("def").set("dynamicviscosity","-1e-3[Pa*s]");
        if(name.equals("reversed_inlet"))m.param().set("Uin","-0.01[m/s]");
        if(name.equals("high_reynolds"))m.param().set("Uin","0.1[m/s]");
        if(name.equals("invalid_k"))m.component("comp1").material("mat1").propertyGroup("def").set("thermalconductivity","-0.6[W/(m*K)]");
        if(name.equals("invalid_cp"))m.component("comp1").material("mat1").propertyGroup("def").set("heatcapacity","0[J/(kg*K)]");
        if(name.equals("invalid_rho"))m.component("comp1").material("mat1").propertyGroup("def").set("density","-1000[kg/m^3]");
        if(name.equals("missing_k"))m.component("comp1").material("mat1").propertyGroup("def").set("thermalconductivity", "");
        if(name.equals("anisotropic_k"))m.component("comp1").material("mat1").propertyGroup("def").set("thermalconductivity",new String[]{"0.6","0","0","0","0.8","0","0","0","1.0"});
        if(name.equals("temperature_dependent_k"))m.component("comp1").material("mat1").propertyGroup("def").set("thermalconductivity","0.6[W/(m*K)]*(T/293.15[K])");
        if(name.equals("empty_heat_flux"))m.component("comp1").physics("ht").feature("flux1").selection().clear();
        if(name.equals("thermal_overlap"))m.component("comp1").physics("ht").feature("flux1").selection().named("inlet");
        if(name.equals("disabled_heat_interface"))m.component("comp1").physics("ht").active(false);
        if(name.equals("disabled_coupling"))m.component("comp1").multiphysics("nitf1").active(false);
        if(name.equals("empty_coupling"))m.component("comp1").multiphysics("nitf1").selection().clear();
        if(name.equals("inactive_heat_study"))m.study("std1").feature("stat").activate("ht",false);
        if(name.startsWith("legal_") && !name.equals("legal_convective_flux"))m.component("comp1").multiphysics().remove("nitf1");
        if(name.equals("legal_prescribed_velocity")) {
          m.component("comp1").physics("ht").feature("fluid1").set("u_src","userdef");
          m.component("comp1").physics("ht").feature("fluid1").set("u",new String[]{"0","0","0.01[m/s]"});
        }
        if(name.equals("legal_convective_flux"))m.component("comp1").physics("ht").feature("flux1").set("HeatFluxType","ConvectiveHeatFlux");
        if(name.equals("conjugate_wrong_coupling_domain"))m.component("comp1").multiphysics("nitf1").selection().named("solid");
        if(name.equals("conjugate_missing_wall_k"))m.component("comp1").material("mat2").propertyGroup("def").set("thermalconductivity", "");
        m.label(name+".mph");m.save(OUTPUT+"/"+name+".mph");
      } finally {ModelUtil.remove("Variant");}
    }
    for(String name:NAMES)verify(name);
    System.out.println("M3_API_VERIFIED");
  }
  private static int[] ints(java.util.ArrayList<Integer> values) {
    int[] ids=new int[values.size()];for(int i=0;i<ids.length;i++)ids[i]=values.get(i);return ids;
  }
  private static void explicit(Model m,String tag,int dim,int[] ids) {
    if(ids.length==0)throw new IllegalStateException("Empty controlled selection "+tag);
    m.component("comp1").selection().create(tag,"Explicit");
    m.component("comp1").selection(tag).geom("geom1",dim);m.component("comp1").selection(tag).set(ids);
  }
  private static Model build(boolean wall) {
    Model m=ModelUtil.create("Build");
    m.label("FlowPilot controlled unsolved 3D pipe");
    m.param().set("R","0.025[m]"); m.param().set("L","1[m]"); m.param().set("Uin","0.01[m/s]");
    m.component().create("comp1",true);
    m.component("comp1").geom().create("geom1",3);
    m.component("comp1").geom("geom1").lengthUnit("m");
    m.component("comp1").geom("geom1").create("c1","Cylinder");
    m.component("comp1").geom("geom1").feature("c1").set("r","R");
    m.component("comp1").geom("geom1").feature("c1").set("h","L");
    if(wall) {
      m.component("comp1").geom("geom1").create("c2","Cylinder");
      m.component("comp1").geom("geom1").feature("c2").set("r","0.03[m]");
      m.component("comp1").geom("geom1").feature("c2").set("h","L");
    }
    m.component("comp1").geom("geom1").run();
    GeomSequence g=m.component("comp1").geom("geom1");
    int fluid=-1,solid=-1;
    for(int id=1;id<=g.getNDomains();id++) {
      g.measureFinal().selection().geom(3);g.measureFinal().selection().set(new int[]{id});
      System.out.println("M3_DOMAIN_MEASURE "+wall+" "+id+" "+g.measureFinal().getVolume()+" "+Arrays.toString(g.measureFinal().getBoundingBox()));
      if(Math.abs(g.measureFinal().getVolume()-Math.PI*.025*.025)<2e-5)fluid=id;else solid=id;
    }
    if(fluid<0 || (wall&&solid<0))throw new IllegalStateException("Controlled fluid domain not built");
    explicit(m,"fluid",3,new int[]{fluid});if(wall)explicit(m,"solid",3,new int[]{solid});
    java.util.ArrayList<Integer> ins=new java.util.ArrayList<Integer>(),outs=new java.util.ArrayList<Integer>(),walls=new java.util.ArrayList<Integer>(),outer=new java.util.ArrayList<Integer>();
    for(int id=1;id<=g.getNBoundaries();id++) {
      g.measureFinal().selection().geom(2);g.measureFinal().selection().set(new int[]{id});
      double[] bb=g.measureFinal().getBoundingBox();
      boolean adjacent=false;for(int d:g.getAdj(2,3,id))if(d==fluid)adjacent=true;
      if(adjacent) {if(Math.abs(bb[4])<1e-8&&Math.abs(bb[5])<1e-8)ins.add(id);
        else if(Math.abs(bb[4]-1)<1e-8&&Math.abs(bb[5]-1)<1e-8)outs.add(id);else walls.add(id);}
      else if(bb[5]-bb[4]>.9)outer.add(id);
    }
    explicit(m,"inlet",2,ints(ins));explicit(m,"outlet",2,ints(outs));explicit(m,"wall",2,ints(walls));
    if(wall)explicit(m,"outer",2,ints(outer));
    m.component("comp1").material().create("mat1","Common");
    m.component("comp1").material("mat1").selection().named("fluid");
    m.component("comp1").material("mat1").propertyGroup("def").set("density","1000[kg/m^3]");
    m.component("comp1").material("mat1").propertyGroup("def").set("dynamicviscosity","1e-3[Pa*s]");
    m.component("comp1").material("mat1").propertyGroup("def").set("thermalconductivity","0.6[W/(m*K)]");
    m.component("comp1").material("mat1").propertyGroup("def").set("heatcapacity","4180[J/(kg*K)]");
    if(wall) {
      m.component("comp1").material().create("mat2","Common");
      m.component("comp1").material("mat2").selection().named("solid");
      m.component("comp1").material("mat2").propertyGroup("def").set("density","7800[kg/m^3]");
      m.component("comp1").material("mat2").propertyGroup("def").set("thermalconductivity","16[W/(m*K)]");
      m.component("comp1").material("mat2").propertyGroup("def").set("heatcapacity","500[J/(kg*K)]");
    }
    m.component("comp1").physics().create("spf","LaminarFlow","geom1");
    m.component("comp1").physics("spf").selection().named("fluid");
    m.component("comp1").physics("spf").create("inl1","Inlet",2);
    m.component("comp1").physics("spf").feature("inl1").selection().named("inlet");
    m.component("comp1").physics("spf").feature("inl1").set("BoundaryCondition","Velocity");
    m.component("comp1").physics("spf").feature("inl1").set("U0in","Uin");
    m.component("comp1").physics("spf").create("out1","Outlet",2);
    m.component("comp1").physics("spf").feature("out1").selection().named("outlet");
    m.component("comp1").physics("spf").feature("out1").set("p0","0[Pa]");
    m.study().create("std1");m.study("std1").create("stat","Stationary");
    m.study("std1").feature("stat").activate("spf",true);
    m.component("comp1").physics().create("ht",wall?"HeatTransfer":"HeatTransferInFluids","geom1");
    if(wall) {
      // Default solid domain selection is managed; the explicit fluid node overrides it.
      m.component("comp1").physics("ht").create("fluid1","FluidHeatTransferModel",3);
      m.component("comp1").physics("ht").feature("fluid1").selection().named("fluid");
    }
    m.component("comp1").physics("ht").feature("fluid1").set("u_src","root.comp1.u");
    m.component("comp1").physics("ht").create("temp1","TemperatureBoundary",2);
    m.component("comp1").physics("ht").feature("temp1").selection().named("inlet");
    m.component("comp1").physics("ht").feature("temp1").set("T0","293.15[K]");
    m.component("comp1").physics("ht").create("flux1","HeatFluxBoundary",2);

    m.component("comp1").physics("ht").feature("flux1").selection().named(wall?"outer":"wall");
    m.component("comp1").physics("ht").feature("flux1").set("q0_input","1000[W/m^2]");
    m.component("comp1").multiphysics().create("nitf1","NonIsothermalFlow",3);
    // NonIsothermalFlow selection is COMSOL-managed from interface overlap.
    m.study("std1").feature("stat").activate("ht",true);
    return m;
  }
  private static void verify(String name) throws Exception {
    String first=null;
    for(int i=0;i<3;i++) {
      Model m=ModelUtil.load("Read",OUTPUT+"/"+name+".mph");
      try {
        if(m.sol().tags().length!=0)throw new IllegalStateException("Unexpected solution sequence");
        String snapshot=inspect(m);
        if(first!=null&&!first.equals(snapshot))throw new IllegalStateException("Inventory drift: "+name);
        first=snapshot;
      } finally {ModelUtil.remove("Read");}
    }
    System.out.println("M3_INVENTORY "+name+" "+first);
    System.out.println("M3_READ_VERIFIED "+name+" 3");
    System.out.println("M3_UNSOLVED_VERIFIED "+name+" 3");
  }
}
